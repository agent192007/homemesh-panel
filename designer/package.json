{
  "name": "homemesh-designer",
  "private": true,
  "version": "0.5.0",
  "description": "HomeMesh layout designer: author the panel's layout against Home Assistant, previewed by the panel's own LVGL code running as WebAssembly.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/format.test.ts && node --experimental-strip-types tests/namefit.test.ts",
    "dist": "npm run build && electron-builder --win portable",
    "start": "node scripts/start.mjs"
  },
  "build": {
    "appId": "in.homemesh.designer",
    "productName": "HomeMesh Designer",
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2"
  }
}
